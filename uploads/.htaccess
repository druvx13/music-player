# uploads/.htaccess
# User-uploaded files are served from this directory.
# CRITICAL: disable PHP (and all server-side script) execution so that a
# maliciously renamed file (e.g. shell.php uploaded as an MP3) cannot run.

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine Off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine Off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine Off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine Off
</IfModule>

# Block execution via AddHandler / ForceType tricks
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Deny direct access to anything that isn't an allowed media file
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow only audio and image files through
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(mp3|ogg|flac|jpg|jpeg|png|gif|webp)$ - [L]

    # Block everything else (e.g. .php, .phtml, .cgi, .pl, .py, .sh …)
    RewriteRule ^ - [F,L]
</IfModule>

# Belt-and-suspenders: explicitly deny PHP via FilesMatch as well
<FilesMatch "\.ph(p[2-8]?|tml|ar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
